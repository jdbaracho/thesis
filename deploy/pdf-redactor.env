# Environment for pdf-redactor.service. Installed to /etc/default/pdf-redactor.
# Edit the installed copy and `sudo systemctl restart pdf-redactor` to apply.
HOST=0.0.0.0
PORT=8000

# Where persistent job data (per-job workdirs + result.zip + job.json) is
# stored. Kept outside the code checkout so `git pull` / redeploys never wipe
# it. The unit's StateDirectory= already sets this to /var/lib/pdf-redactor;
# uncomment to override.
# PDF_REDACTOR_DATA_DIR=/var/lib/pdf-redactor

[Unit]
Description=PDF Redactor API
Documentation=https://github.com/
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=link
Group=link
WorkingDirectory=/home/link/thesis
EnvironmentFile=-/etc/default/pdf-redactor
ExecStart=/home/link/thesis/.venv/bin/python -m src.job_controller
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pdf-redactor

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Persistent job data lives outside the code checkout so redeploys/updates
# never wipe it. systemd creates and owns /var/lib/pdf-redactor (0750,
# User/Group below) and exposes it as $STATE_DIRECTORY.
StateDirectory=pdf-redactor
StateDirectoryMode=0750
Environment=PDF_REDACTOR_DATA_DIR=/var/lib/pdf-redactor
ReadWritePaths=/home/link/thesis/output /home/link/thesis/input /home/link/thesis/src/output /home/link/.cache

[Install]
WantedBy=multi-user.target
